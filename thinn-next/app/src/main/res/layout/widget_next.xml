<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_next_background" android:orientation="vertical"
    android:padding="18dp">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="thinn-khì NEXT" android:textColor="#D0EDFA" android:textSize="14sp" />
    <TextView android:id="@+id/widget_mood" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="☁️" android:textSize="37sp" android:paddingTop="2dp" />
    <TextView android:id="@+id/widget_temperature" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="尚未取得天氣" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="點擊開啟 App 更新" android:textColor="#C5DDE9" android:textSize="14sp" android:maxLines="2" />
</LinearLayout>
