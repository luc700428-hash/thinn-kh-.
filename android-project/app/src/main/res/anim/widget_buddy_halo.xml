<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="true" android:interpolator="@android:interpolator/accelerate_decelerate">
 <!-- 2.6 s glow, deliberately out of step with the 3.6 s float so the loop never reads as repeating. -->
 <alpha android:fromAlpha="0.45" android:toAlpha="1" android:duration="1300" android:repeatCount="1" android:repeatMode="reverse"/>
 <scale android:fromXScale="0.92" android:toXScale="1.06" android:fromYScale="0.92" android:toYScale="1.06" android:pivotX="50%" android:pivotY="50%" android:duration="1300" android:repeatCount="1" android:repeatMode="reverse"/>
</set>
