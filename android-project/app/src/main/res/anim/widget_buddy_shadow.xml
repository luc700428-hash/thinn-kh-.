<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="true" android:interpolator="@android:interpolator/accelerate_decelerate">
 <!-- Same 3.6 s timing as the float: the shadow tightens and fades as the buddy rises. -->
 <scale android:fromXScale="1.0" android:toXScale="0.78" android:fromYScale="1.0" android:toYScale="0.8" android:pivotX="50%" android:pivotY="50%" android:duration="1800" android:repeatCount="1" android:repeatMode="reverse"/>
 <alpha android:fromAlpha="1" android:toAlpha="0.55" android:duration="1800" android:repeatCount="1" android:repeatMode="reverse"/>
</set>
