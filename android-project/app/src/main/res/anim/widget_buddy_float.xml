<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="true" android:interpolator="@android:interpolator/accelerate_decelerate">
 <!-- One 3.6 s loop: rise while stretching a little, settle while squashing a little, with a gentle sway. -->
 <translate android:fromYDelta="1.5%" android:toYDelta="-5.5%" android:duration="1800" android:repeatCount="1" android:repeatMode="reverse"/>
 <scale android:fromXScale="1.025" android:toXScale="0.985" android:fromYScale="0.975" android:toYScale="1.03" android:pivotX="50%" android:pivotY="88%" android:duration="1800" android:repeatCount="1" android:repeatMode="reverse"/>
 <rotate android:fromDegrees="-1.6" android:toDegrees="2.2" android:pivotX="50%" android:pivotY="80%" android:duration="1800" android:repeatCount="1" android:repeatMode="reverse"/>
 <alpha android:fromAlpha="0.94" android:toAlpha="1" android:duration="1800" android:repeatCount="1" android:repeatMode="reverse"/>
</set>
