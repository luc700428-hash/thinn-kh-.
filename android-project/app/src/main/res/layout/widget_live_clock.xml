<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextClock android:id="@+id/widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:fontFamily="sans-serif-light" android:gravity="center_vertical" android:textSize="46sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:singleLine="true"/>
    <TextClock android:id="@+id/widget_clock_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="M月d日 EEEE" android:format24Hour="M月d日 EEEE" android:fontFamily="sans-serif" android:textSize="12sp" android:textColor="#D5D5DA" android:includeFontPadding="false" android:singleLine="true"/>
</LinearLayout>
