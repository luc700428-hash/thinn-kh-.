<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/buddy_root" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false">
 <ViewFlipper android:id="@+id/buddy_halo" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="2600" android:inAnimation="@anim/widget_buddy_halo"><ImageView android:id="@+id/buddy_halo_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/></ViewFlipper>
    <ViewFlipper android:id="@+id/buddy_shadow" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="3600" android:inAnimation="@anim/widget_buddy_shadow"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_buddy_shadow" android:importantForAccessibility="no"/></ViewFlipper>
 <ViewFlipper android:id="@+id/buddy_float" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="3600" android:inAnimation="@anim/widget_buddy_float" android:outAnimation="@anim/widget_buddy_hide" android:clipChildren="false"/>
 <ViewFlipper android:id="@+id/buddy_rain" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="50"/>
 <ViewFlipper android:id="@+id/buddy_ground" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="50"/>
 <ImageView android:id="@+id/buddy_still" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone"/>
</FrameLayout>
