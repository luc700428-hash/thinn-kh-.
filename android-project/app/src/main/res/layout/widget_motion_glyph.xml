<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <ViewFlipper android:id="@+id/widget_glyph_motion" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="1800" android:inAnimation="@anim/widget_glass_in" android:outAnimation="@anim/widget_glass_out">
  <ImageView android:id="@+id/widget_glyph_a" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:scaleType="fitCenter" android:contentDescription="天氣圖示"/>
  <ImageView android:id="@+id/widget_glyph_b" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:scaleType="fitCenter" android:contentDescription="天氣圖示"/>
 </ViewFlipper>
 <ImageView android:id="@+id/widget_glyph_static" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="天氣圖示"/>
</FrameLayout>
